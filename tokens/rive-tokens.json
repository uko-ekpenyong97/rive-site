{
  "$description": "Rive design tokens — reverse-engineered from rive.app (homepage, pricing, product-design use case) on 2026-06-30. W3C DTCG format. Semantic colors alias primitives. Dark is the default theme; light is provided for occasional light surfaces.",
  "primitive": {
    "neutral": {
      "0":    { "$type": "color", "$value": "#FFFFFF" },
      "50":   { "$type": "color", "$value": "#F2F0F0" },
      "100":  { "$type": "color", "$value": "#F1F1F1" },
      "200":  { "$type": "color", "$value": "#EBEBEB" },
      "400":  { "$type": "color", "$value": "#AAAAAA" },
      "500":  { "$type": "color", "$value": "#999999" },
      "700":  { "$type": "color", "$value": "#262626" },
      "750":  { "$type": "color", "$value": "#212121" },
      "800":  { "$type": "color", "$value": "#1D1D1D" },
      "850":  { "$type": "color", "$value": "#121212" },
      "900":  { "$type": "color", "$value": "#111111" },
      "1000": { "$type": "color", "$value": "#000000" }
    },
    "alpha": {
      "white-60": { "$type": "color", "$value": "rgba(255,255,255,0.60)" },
      "white-10": { "$type": "color", "$value": "rgba(255,255,255,0.10)" }
    },
    "amber": {
      "400":  { "$type": "color", "$value": "#FFB84D", "$description": "authored" },
      "500":  { "$type": "color", "$value": "#FFA41C", "$description": "verified base accent" },
      "600":  { "$type": "color", "$value": "#E8901A", "$description": "authored" },
      "tint": { "$type": "color", "$value": "rgba(255,164,28,0.12)", "$description": "authored" }
    },
    "expressive": {
      "mint":    { "$type": "color", "$value": "#78FACB", "$description": "illustration palette" },
      "sky":     { "$type": "color", "$value": "#57A5E0", "$description": "illustration palette" },
      "coral":   { "$type": "color", "$value": "#E05867", "$description": "illustration palette" },
      "magenta": { "$type": "color", "$value": "#98347A", "$description": "illustration palette" }
    }
  },
  "semantic": {
    "dark": {
      "surface": {
        "canvas":  { "$type": "color", "$value": "{primitive.neutral.1000}" },
        "default": { "$type": "color", "$value": "{primitive.neutral.850}" },
        "raised":  { "$type": "color", "$value": "{primitive.neutral.800}" },
        "overlay": { "$type": "color", "$value": "{primitive.neutral.700}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.neutral.0}" },
        "heading":   { "$type": "color", "$value": "{primitive.neutral.100}" },
        "secondary": { "$type": "color", "$value": "{primitive.neutral.400}" },
        "muted":     { "$type": "color", "$value": "{primitive.alpha.white-60}" },
        "accent":    { "$type": "color", "$value": "{primitive.amber.500}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{primitive.alpha.white-10}" },
        "default": { "$type": "color", "$value": "{primitive.neutral.700}" }
      },
      "accent": {
        "default":   { "$type": "color", "$value": "{primitive.amber.500}" },
        "hover":     { "$type": "color", "$value": "{primitive.amber.400}" },
        "on-accent": { "$type": "color", "$value": "{primitive.neutral.1000}" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.amber.500}" }
      }
    },
    "light": {
      "surface": {
        "canvas":  { "$type": "color", "$value": "{primitive.neutral.0}" },
        "default": { "$type": "color", "$value": "{primitive.neutral.100}" },
        "raised":  { "$type": "color", "$value": "{primitive.neutral.200}" },
        "overlay": { "$type": "color", "$value": "{primitive.neutral.200}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.neutral.1000}" },
        "heading":   { "$type": "color", "$value": "{primitive.neutral.1000}" },
        "secondary": { "$type": "color", "$value": "{primitive.neutral.500}" },
        "muted":     { "$type": "color", "$value": "{primitive.neutral.500}" },
        "accent":    { "$type": "color", "$value": "{primitive.amber.500}" }
      },
      "border": {
        "subtle":  { "$type": "color", "$value": "{primitive.neutral.200}" },
        "default": { "$type": "color", "$value": "{primitive.neutral.200}" }
      },
      "accent": {
        "default":   { "$type": "color", "$value": "{primitive.amber.500}" },
        "hover":     { "$type": "color", "$value": "{primitive.amber.600}" },
        "on-accent": { "$type": "color", "$value": "{primitive.neutral.1000}" }
      },
      "focus": {
        "ring": { "$type": "color", "$value": "{primitive.amber.500}" }
      }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": "Tomorrow, sans-serif" },
      "body":    { "$type": "fontFamily", "$value": "Inter, \"Inter Display\", sans-serif" },
      "mono":    { "$type": "fontFamily", "$value": "\"JetBrains Mono\", monospace" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    }
  },
  "fontSize": {
    "h1":      { "$type": "dimension", "$value": "40px" },
    "h2":      { "$type": "dimension", "$value": "24px" },
    "stat":    { "$type": "dimension", "$value": "28px" },
    "eyebrow": { "$type": "dimension", "$value": "14px" },
    "body":    { "$type": "dimension", "$value": "16px" },
    "body-sm": { "$type": "dimension", "$value": "14px" },
    "caption": { "$type": "dimension", "$value": "13px" },
    "code":    { "$type": "dimension", "$value": "14px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "8px" },
    "lg":   { "$type": "dimension", "$value": "16px", "$description": "authored" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "space": {
    "$description": "authored — no systematic scale on the source site",
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "motion": {
    "$description": "authored — tune in DialKit",
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "240ms" },
      "slow": { "$type": "duration", "$value": "400ms" }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.3, 0, 0, 1] }
    }
  }
}
